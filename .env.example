# 应用监听端口（宿主机映射）
APP_PORT=8080

# PostgreSQL 连接配置（docker compose 内部服务名固定为 db）
POSTGRES_USER=caltrace
POSTGRES_PASSWORD=caltrace
POSTGRES_DB=caltrace
# 数据库在宿主机暴露的端口，默认仅绑定回环地址；不对外可用可直接删除映射
POSTGRES_PORT=127.0.0.1:5432

# 若不用 compose、直连外部数据库，应用读取以下变量（app/config.py）：
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=caltrace
# DB_USER=caltrace
# DB_PASSWORD=caltrace
